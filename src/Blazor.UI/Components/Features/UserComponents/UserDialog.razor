@inject Radzen.DialogService dialogService

<RadzenStack Gap="1.25rem" class="user-dialog-form">
    <RadzenCard class="user-dialog-card">
        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3" Text="@Title" class="rz-mb-4" />
        <RadzenStack Gap="1rem">
            <RadzenFormField Text="Username">
                <RadzenTextBox @bind-Value="@Data.UserName" Name="Username" Placeholder="Enter Username" class="input-form" />
            </RadzenFormField>
            <RadzenFormField Text="Firstname">
                <RadzenTextBox @bind-Value="@Data.FirstName" Name="Firstname" Placeholder="Enter Firstname" class="input-form" />
            </RadzenFormField>
            <RadzenFormField Text="Lastname">
                <RadzenTextBox @bind-Value="@Data.LastName" Name="Lastname" Placeholder="Enter Lastname" class="input-form"/>
            </RadzenFormField>
            <RadzenFormField Text="Date Of Birth">
                <RadzenDatePicker @bind-Value="@DateOfBirthValue" Name="Date Of Birth" Placeholder="Select Date" class="input-form" />
            </RadzenFormField>
            <RadzenFormField Text="Email">
                <RadzenTextBox @bind-Value="@Data.Email" Name="Email" Placeholder="Enter Email" class="input-form" />
            </RadzenFormField>
        </RadzenStack>
    </RadzenCard>

    <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="0.75rem" JustifyContent="JustifyContent.End" class="user-dialog-actions">
        <RadzenButton Click="@SubmitForm" Text="Submit" />
        <RadzenButton Click="@((args) => dialogService.Close(true))" Text="Close" ButtonStyle="ButtonStyle.Secondary" />
    </RadzenStack>
</RadzenStack>

