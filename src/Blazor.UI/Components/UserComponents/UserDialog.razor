@inject Radzen.DialogService dialogService

<RadzenStack>
    <RadzenRow Gap="2rem" RowGap="2rem" class="rz-m-0 rz-m-md-12">
        <RadzenColumn Size="12">
            <RadzenCard>
                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3" Text="@Title"></RadzenText>
                <RadzenTextArea Value="@Data.UserName" Change=@(args => OnChange(args, "TextArea")) Style="width: 100%" aria-label="TextArea" />
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow>
        <RadzenButton Click="@SubmitForm" Text="Submit"/>
        <RadzenButton Click="@((args) => dialogService.Close(true))" Text="Close" />
    </RadzenRow>

</RadzenStack>


@code {
    [Parameter] 
    public UserDTO Data {get; set;} = default!;
    [Inject] 
    UserService service {get; set;} = default!;

    string Title {get => (Data.Id == 0) ? "Add" : "Edit"; }

    void OnChange(string value, string name)
    {
        if(Data != null && !string.IsNullOrEmpty(value))
        {
            Data.UserName = value; 
        }

    }

    async Task SubmitForm() {
        if(Data != null && Data.Id > 0 && !string.IsNullOrEmpty(Data.UserName) ) {
            await service.UpdateAsync(Data);
        }
        else if (Data != null && Data.Id == 0 && !string.IsNullOrEmpty(Data.UserName)){
            await service.CreateAsync(Data);
        }

        dialogService.Close(true);
    }
}      
