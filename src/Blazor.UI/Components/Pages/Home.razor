@page "/"
@page "/home"
@using Microsoft.AspNetCore.Components.Web
@inject ILogger<Home> logger;

<PageTitle>Home</PageTitle>


<div class="home-page">
    <h2>@WelcomeMessage</h2>
    <p>@Author</p>

    <div class="home-actions">
        <NavigateToPage Path=@NavigationConstants.Weather />
        <NavigateToPage Path=@NavigationConstants.Counter />
        <NavigateToPage Path=@NavigationConstants.User />
    </div>
</div>

@code
{
    private readonly string WelcomeMessage = "Welcome to Blazor UI";
    private readonly string Author = "By Preetpal Basson (Developed & Designed)";

    protected async override Task OnInitializedAsync()
    {
        logger.LogInformation("Home Page: Loaded");
    }
}
