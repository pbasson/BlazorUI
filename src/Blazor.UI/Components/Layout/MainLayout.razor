@inherits LayoutComponentBase
<RadzenComponents  />
<RadzenDialog />
<Toasts class="p-3" AutoHide="true" Delay="5000" Placement="ToastsPlacement.TopRight" />

<div class="page containerStyle">
    <div class="sidebar @(_isNavCollapsed ? "collapsed" : null)">
        <NavMenu IsCollapsed="@_isNavCollapsed" OnToggle="ToggleNav" />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    
    </main>
</div>

@code {
    private bool _isNavCollapsed;

    private void ToggleNav()
    {
        _isNavCollapsed = !_isNavCollapsed;
    }
}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
